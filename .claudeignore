# .claudeignore
# Files and directories to exclude from Claude Code context

# Dependencies
node_modules/
vendor/
bower_components/

# Build outputs
dist/
build/
out/
target/
*.min.js
*.min.css

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Test coverage
coverage/
.nyc_output/
*.lcov

# Environment files
.env
.env.local
.env.*.local

# Temporary files
tmp/
temp/
*.tmp

# Large media files
*.mp4
*.mov
*.avi
*.mkv
*.pdf
*.zip
*.tar.gz

# Git
.git/
